# Prefer: python scripts/dev_setup.py (creates ignored .env without printing secrets)
POSTGRES_PASSWORD=change-local-owner-password
APP_DB_PASSWORD=change-local-runtime-password
MOODWALL_DATABASE_URL=postgresql://moodwall_app:change-local-runtime-password@localhost:55432/moodwall
MOODWALL_MIGRATION_DATABASE_URL=postgresql://postgres:change-local-owner-password@localhost:55432/moodwall
MOODWALL_PUBLIC_ORIGIN=http://localhost:8000
MOODWALL_BOARD_ID=10000000-0000-4000-8000-000000000001
MOODWALL_SECRET_KEY=change-session-key-use-random-48-bytes
MOODWALL_QR_KEY=change-qr-key-use-different-random-48-bytes
MOODWALL_ENVIRONMENT=development
MOODWALL_ANALYZER=fake
